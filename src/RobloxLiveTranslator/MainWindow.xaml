<Window x:Class="RobloxLiveTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RoiLingo" Width="960" Height="190" MinWidth="900" MinHeight="175"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="8" Padding="7">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PickWindowButton" Content="대상" Click="PickWindowButton_Click" Padding="12,6" Margin="2" ToolTip="번역할 게임/프로그램 창 선택"/>
                    <Button x:Name="EditRoiButton" Content="ROI" Click="EditRoiButton_Click" Padding="12,6" Margin="2" ToolTip="화면에서 번역할 영역 지정"/>
                    <Button x:Name="QuickTranslateButton" Content="빠른번역" Click="QuickTranslateButton_Click" Padding="11,6" Margin="2" ToolTip="현재 화면에서 한 번만 영역을 골라 번역 (Ctrl+Alt+T). 우클릭: 다른 빠른 번역">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="영역 선택 번역 (Ctrl+Alt+T)" Click="QuickRegionMenuItem_Click"/>
                                <MenuItem Header="활성 창 전체 번역 (Ctrl+Alt+W)" Click="QuickWindowMenuItem_Click"/>
                                <MenuItem Header="클립보드 텍스트 번역 (Ctrl+Alt+V)" Click="QuickClipboardMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="StartButton" Content="시작" Click="StartButton_Click" FontWeight="Bold" Padding="16,6" Margin="6,2,2,2"/>
                    <Button x:Name="StopButton" Content="중지" Click="StopButton_Click" IsEnabled="False" Padding="12,6" Margin="2"/>
                    <Button x:Name="QuickOverlayEditButton" Content="오버레이" Click="ToggleOverlayEditModeButton_Click" IsEnabled="False" Padding="10,6" Margin="8,2,2,2" ToolTip="게임 위 번역 박스 위치/크기/투명도 조절"/>
                    <Button x:Name="LiveWindowButton" Content="번역창" Click="PreviewLiveWindowButton_Click" Padding="10,6" Margin="2" ToolTip="별도 실시간 번역 창 열기/다시 열기"/>
                    <Button x:Name="AdvancedSettingsButton" Content="설정" Click="AdvancedSettingsButton_Click" Padding="10,6" Margin="8,2,2,2" ToolTip="OCR, 번역기, API, 기록, 로그 등 고급 설정"/>
                    <ComboBox x:Name="UiLanguageCombo" Width="92" Margin="8,2,2,2" SelectionChanged="UiLanguageCombo_SelectionChanged" ToolTip="UI language">
                        <ComboBoxItem Content="한국어" Tag="ko-KR"/><ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3,7,0,0">
                    <TextBlock x:Name="SourceLabel" Text="원문" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="SourceLanguageCombo" Width="125" SelectedValuePath="Tag" ToolTip="원문 언어. 자동 감지를 선택하면 번역기는 자동 감지하고 OCR은 옆의 다중 OCR 언어 선택을 사용합니다.">
                        <ComboBoxItem Content="자동 감지" Tag="auto"/><ComboBoxItem Content="영어" Tag="en"/><ComboBoxItem Content="한국어" Tag="ko"/>
                        <ComboBoxItem Content="일본어" Tag="ja"/><ComboBoxItem Content="중국어(간체)" Tag="zh-CN"/><ComboBoxItem Content="중국어(번체)" Tag="zh-TW"/>
                        <ComboBoxItem Content="스페인어" Tag="es"/><ComboBoxItem Content="프랑스어" Tag="fr"/><ComboBoxItem Content="독일어" Tag="de"/><ComboBoxItem Content="러시아어" Tag="ru"/>
                        <ComboBoxItem Content="포르투갈어" Tag="pt"/><ComboBoxItem Content="이탈리아어" Tag="it"/><ComboBoxItem Content="베트남어" Tag="vi"/><ComboBoxItem Content="태국어" Tag="th"/>
                        <ComboBoxItem Content="인도네시아어" Tag="id"/><ComboBoxItem Content="힌디어" Tag="hi"/><ComboBoxItem Content="아랍어" Tag="ar"/>
                    </ComboBox>
                    <Button x:Name="OcrLanguagePickerButton" Content="OCR: 영+한" Click="OcrLanguagePickerButton_Click" Padding="9,4" Margin="7,0,0,0"
                            ToolTip="OCR에서 동시에 읽을 언어를 여러 개 선택"/>
                    <TextBlock x:Name="TargetLabel" Text="→ 번역" VerticalAlignment="Center" Margin="12,0,5,0"/>
                    <ComboBox x:Name="TargetLanguageCombo" Width="125" SelectedValuePath="Tag">
                        <ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="영어" Tag="en"/><ComboBoxItem Content="일본어" Tag="ja"/>
                        <ComboBoxItem Content="중국어(간체)" Tag="zh-CN"/><ComboBoxItem Content="중국어(번체)" Tag="zh-TW"/><ComboBoxItem Content="스페인어" Tag="es"/>
                        <ComboBoxItem Content="프랑스어" Tag="fr"/><ComboBoxItem Content="독일어" Tag="de"/><ComboBoxItem Content="러시아어" Tag="ru"/>
                        <ComboBoxItem Content="포르투갈어" Tag="pt"/><ComboBoxItem Content="이탈리아어" Tag="it"/><ComboBoxItem Content="베트남어" Tag="vi"/><ComboBoxItem Content="태국어" Tag="th"/>
                        <ComboBoxItem Content="인도네시아어" Tag="id"/><ComboBoxItem Content="힌디어" Tag="hi"/><ComboBoxItem Content="아랍어" Tag="ar"/>
                    </ComboBox>
                    <TextBlock x:Name="ModeLabel" Text="방식" VerticalAlignment="Center" Margin="18,0,5,0"/>
                    <ComboBox x:Name="TranslationStrategyCombo" Width="235" SelectedValuePath="Tag" ToolTip="무료 웹은 API 키 없이 Papago/Google/DeepL을 교차 확인합니다.">
                        <ComboBoxItem Content="무료 · Web 3종 교차검증" Tag="WebOnly"/>
                        <ComboBoxItem Content="API/로컬 우선 · Web 보조검증" Tag="HybridBalanced"/>
                        <ComboBoxItem Content="API/로컬만 (안정 우선)" Tag="ApiOnly"/>
                        <ComboBoxItem Content="전체 Provider 교차검증" Tag="MaximumCrossCheck"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="4,7,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TargetWindowText" Grid.Column="0" Text="대상 창이 선택되지 않음" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="현재 대상 창"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="준비" Foreground="#555" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Border x:Name="AdvancedPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"
                BorderBrush="#CFCFCF" BorderThickness="1" CornerRadius="8" Background="White" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="2,0,2,8">
                    <TextBlock x:Name="AdvancedTitleText" Text="고급 설정" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="AdvancedSaveButton" Content="저장" Click="SaveSettingsButton_Click" Padding="12,5" Margin="2"/>
                        <Button x:Name="AdvancedCloseButton" Content="닫기" Click="CloseAdvancedSettingsButton_Click" Padding="12,5" Margin="2"/>
                    </StackPanel>
                </DockPanel>
                <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem x:Name="GeneralTab" Header="설정 / ROI">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <GroupBox Header="OCR / 감시 설정" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Tesseract 언어팩"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="OcrLanguagesBox" ToolTip="예: eng 또는 eng+kor+jpn+chi_sim"/>
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="OCR 정확도 모드"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="OcrModeCombo" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="빠름" Tag="Fast"/>
                                    <ComboBoxItem Content="균형" Tag="Balanced"/>
                                    <ComboBoxItem Content="정확도 우선" Tag="Accurate"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="OCR 언어를 원문 언어에 맞춤"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="OcrLanguageFollowsSourceCheck" Content="원문 언어 변경 시 Tesseract 언어팩 자동 선택" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="혼합 언어 스마트 처리"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="SmartMixedTextCheck" Content="목표 언어가 이미 섞여 있으면 그 부분은 제외하고 나머지만 번역" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="화면 검사 간격(ms)"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="PollIntervalBox"/>
                                <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="변화 감도 (0.01~0.20)"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="ChangeThresholdBox"/>
                                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="창 캡처 방식"/>
                                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="CaptureModeCombo" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="자동 (권장: 전면 게임=화면 / 비활성=백그라운드)" Tag="Auto"/>
                                    <ComboBoxItem Content="백그라운드 우선" Tag="BackgroundFirst"/>
                                    <ComboBoxItem Content="백그라운드만 (화면 복사 사용 안 함)" Tag="BackgroundOnly"/>
                                </ComboBox>
                                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="4,8,4,0" Foreground="#666" TextWrapping="Wrap"
                                           Text="자동 감지에서는 'OCR 언어' 버튼에서 선택한 언어팩을 동시에 사용합니다. ROI는 창 내부 비율 좌표로 저장되어 창이 이동해도 유지됩니다. 자동은 전면 게임에서는 실제 화면을 우선 사용하고, 가려진/비활성 창에서는 PrintWindow 백그라운드 캡처를 시도합니다."/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="자동 기록 / 표시">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="AutoSaveHistoryCheck" Content="OCR / 번역 결과 자동 저장" IsChecked="True"/>
                                <CheckBox x:Name="LiveWindowEnabledCheck" Content="시작할 때 별도 실시간 번역 창 자동 열기" IsChecked="False" Margin="0,7,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Content="실시간 번역 창 열기/다시 열기" Click="PreviewLiveWindowButton_Click" Padding="10,5"/>
                                    <Button x:Name="OverlayEditModeButton" Content="게임 오버레이 직접 편집" Click="ToggleOverlayEditModeButton_Click" Padding="10,5" Margin="8,0,0,0"/>
                                    <Button Content="게임 오버레이 세부 설정" Click="OpenOverlaySettingsButton_Click" Padding="10,5" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Margin="0,7,0,0" Foreground="#666" TextWrapping="Wrap"
                                           Text="게임 위 반투명 오버레이와 별도 실시간 번역 창은 서로 독립적입니다. 둘 다 위치/표시를 조절할 수 있고 설정이 자동 저장됩니다."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <GroupBox Grid.Column="1" Header="ROI 목록">
                        <DockPanel Margin="6">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="선택 ROI 삭제" Click="DeleteRoiButton_Click" Padding="10,5"/>
                            </StackPanel>
                            <DataGrid x:Name="RoiGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="55"/>
                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="오버레이" Binding="{Binding ShowOverlay}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="이벤트" Binding="{Binding EventMode}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="WebTab" Header="번역 웹 / 교차 검증">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <CheckBox x:Name="PapagoWebEnabled" Content="Papago" Margin="4"/>
                                <CheckBox x:Name="GoogleWebEnabled" Content="Google" Margin="12,4,4,4"/>
                                <CheckBox x:Name="DeepLWebEnabled" Content="DeepL" Margin="12,4,4,4"/>
                                <CheckBox x:Name="ClipboardFallbackCheck" Content="복사 버튼/클립보드 폴백" Margin="18,4,4,4"/>
                                <TextBlock Text="웹 타임아웃(ms)" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                <TextBox x:Name="WebTimeoutBox" Width="70"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="번역 캐시 비우기" Click="ClearTranslationCacheButton_Click" Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="이전 버전에서 잘못 저장된 번역을 버리고 다음 OCR 문장을 다시 번역합니다."/>
                                <Button Content="번역 결과 읽기 테스트" Click="TestWebTranslatorsButton_Click" Padding="10,5" Margin="0,0,6,0"/>
                                <Button Content="번역 사이트 초기화/새로고침" Click="InitializeWebTranslatorsButton_Click" Padding="10,5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TabControl Grid.Row="1" x:Name="TranslatorSiteTabs">
                        <TabItem Header="Papago"><Grid><wv2:WebView2 x:Name="PapagoWebView"/></Grid></TabItem>
                        <TabItem Header="Google 번역"><Grid><wv2:WebView2 x:Name="GoogleWebView"/></Grid></TabItem>
                        <TabItem Header="DeepL"><Grid><wv2:WebView2 x:Name="DeepLWebView"/></Grid></TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem x:Name="ApiTab" Header="번역 API / 로컬">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="번역 실행 전략" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="310"/><ColumnDefinition Width="140"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="전략"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#555" Text="기본 창의 '방식' 선택값을 사용합니다."/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="최종 결과 우선" Margin="12,0,0,0"/>
                                <ComboBox Grid.Column="3" x:Name="PreferredProviderCombo">
                                    <ComboBoxItem Content="Auto"/><ComboBoxItem Content="Papago API"/><ComboBoxItem Content="Google API"/>
                                    <ComboBoxItem Content="DeepL API"/><ComboBoxItem Content="LibreTranslate"/><ComboBoxItem Content="Papago Web"/>
                                    <ComboBoxItem Content="Google Web"/><ComboBoxItem Content="DeepL Web"/>
                                </ComboBox>
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="API 타임아웃(ms)" Margin="12,0,0,0"/>
                                <TextBox Grid.Column="5" x:Name="ApiTimeoutBox"/>
                            </Grid>
                        </GroupBox>

                        <TextBlock Margin="4,0,4,8" Foreground="#555" TextWrapping="Wrap"
                                   Text="API 키는 settings.json이나 Git 저장소에 저장하지 않고 Windows 사용자 계정 DPAPI로 암호화합니다. 일/월 한도를 0으로 두면 제한 없음입니다. 'API/로컬 우선 · Web 보조검증'은 API/로컬 1개와 Web 1개를 조합해 크레딧 사용을 줄입니다."/>

                        <GroupBox Header="Papago Text Translation API" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="PapagoApiEnabled" Content="사용" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="Client ID"/><PasswordBox x:Name="PapagoClientIdBox"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="Client Secret" VerticalAlignment="Center" Margin="8,0"/>
                                <PasswordBox Grid.Column="3" x:Name="PapagoClientSecretBox"/>
                                <TextBlock Grid.Column="4" Text="일 요청 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="5" x:Name="PapagoDailyLimitBox"/>
                                <TextBlock Grid.Column="6" Text="월 문자 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="7" x:Name="PapagoMonthlyLimitBox"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Google Cloud Translation Basic API" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="560"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="GoogleApiEnabled" Content="사용" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="API Key"/><PasswordBox x:Name="GoogleApiKeyBox"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="일 요청 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="3" x:Name="GoogleDailyLimitBox"/>
                                <TextBlock Grid.Column="4" Text="월 문자 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="5" x:Name="GoogleMonthlyLimitBox"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="DeepL API" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="470"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="DeepLApiEnabled" Content="사용" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="Authentication Key"/><PasswordBox x:Name="DeepLApiKeyBox"/></StackPanel>
                                <CheckBox Grid.Column="2" x:Name="DeepLFreeEndpointCheck" Content="Free API" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="3" Text="일 요청 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="4" x:Name="DeepLDailyLimitBox"/>
                                <TextBlock Grid.Column="5" Text="월 문자 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="6" x:Name="DeepLMonthlyLimitBox"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="LibreTranslate / Argos Translate 호환 (오픈소스, 로컬 권장)" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="380"/><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="LibreApiEnabled" Content="사용" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="Endpoint (예: http://localhost:5000)"/><TextBox x:Name="LibreEndpointBox"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="API Key (로컬이면 비워도 됨)"/><PasswordBox x:Name="LibreApiKeyBox"/></StackPanel>
                                <TextBlock Grid.Column="3" Text="일 요청 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="4" x:Name="LibreDailyLimitBox"/>
                                <TextBlock Grid.Column="5" Text="월 문자 한도" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBox Grid.Column="6" x:Name="LibreMonthlyLimitBox"/>
                            </Grid>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="ApiUsageText" VerticalAlignment="Center" Foreground="#555" Margin="0,0,14,0" Text="사용량: 아직 없음"/>
                            <Button Content="API/로컬 연결 테스트" Click="TestApiProvidersButton_Click" Padding="10,5" Margin="2"/>
                            <Button Content="로컬 사용량 카운터 초기화" Click="ResetApiUsageButton_Click" Padding="10,5" Margin="2"/>
                            <Button Content="API 설정/비밀키 저장" Click="SaveApiSettingsButton_Click" Padding="10,5" Margin="2"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HistoryTab" Header="번역 기록">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="HistoryFilterBox" Width="300" TextChanged="HistoryFilterBox_TextChanged" ToolTip="ROI, 원문, 번역문, Provider 검색"/>
                            <TextBlock x:Name="HistoryCountText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="CSV 내보내기" Click="ExportHistoryButton_Click" Padding="10,5" Margin="2"/>
                            <Button Content="로그 폴더 열기" Click="OpenLogFolderButton_Click" Padding="10,5" Margin="2"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionChanged="HistoryGrid_SelectionChanged" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간" Binding="{Binding Timestamp, StringFormat=MM-dd HH:mm:ss}" Width="115"/>
                            <DataGridTextColumn Header="ROI" Binding="{Binding RoiName}" Width="110"/>
                            <DataGridTextColumn Header="원문" Binding="{Binding SourceText}" Width="2*"/>
                            <DataGridTextColumn Header="번역" Binding="{Binding TargetText}" Width="2*"/>
                            <DataGridTextColumn Header="선택" Binding="{Binding Provider}" Width="120"/>
                            <DataGridTextColumn Header="일치도" Binding="{Binding AgreementScore, StringFormat=P0}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Row="2" Header="선택 기록 - Provider별 결과" Margin="0,8,0,0">
                        <ListBox x:Name="ProviderResultList" FontFamily="Consolas" FontSize="12"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
                <GroupBox Grid.Row="2" Header="실행 로그 (자동 저장)" Margin="0,8,0,0">
                    <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</Window>
