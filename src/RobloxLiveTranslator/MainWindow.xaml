<Window x:Class="RobloxLiveTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RoiLingo" Width="420" Height="680" MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3D8BFF" Offset="0"/><GradientStop Color="#2366D1" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="0,0,6,0" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter TargetName="NavChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="{StaticResource SurfacePressedBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavChrome" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StartNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/><Setter Property="BorderBrush" Value="#5BA0FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/><Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelBackground}"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="8,7"/>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource PanelBackground}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,11">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}"><TextBlock Text="R" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="RoiLingo" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="ROI GAME TRANSLATOR" Style="{StaticResource SectionLabel}" Margin="0,1,0,0"/></StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#16263D" BorderBrush="#294364" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/><TextBlock Text="  " Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="StatusText" Text="준비" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="255"/></StackPanel></Border>
                <ComboBox x:Name="UiLanguageCombo" Width="84" Height="34" SelectionChanged="UiLanguageCombo_SelectionChanged" ToolTip="UI language"><ComboBoxItem Content="한국어" Tag="ko-KR"/><ComboBoxItem Content="English" Tag="en-US"/><ComboBoxItem Content="日本語" Tag="ja-JP"/><ComboBoxItem Content="简体中文" Tag="zh-CN"/></ComboBox>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="7,6" Margin="0,0,0,9">
            <UniformGrid Columns="2">
                <Button x:Name="PickWindowButton" Style="{StaticResource NavButton}" Tag="&#xE707;" Content="대상" Click="PickWindowButton_Click" ToolTip="번역할 게임/프로그램 창 선택"/>
                <Button x:Name="EditRoiButton" Style="{StaticResource NavButton}" Tag="&#xE7C5;" Content="ROI" Click="EditRoiButton_Click" ToolTip="화면에서 번역할 영역 지정"/>
                <Button x:Name="QuickTranslateButton" Style="{StaticResource NavButton}" Tag="&#xE945;" Content="빠른번역" Click="QuickTranslateButton_Click" ToolTip="현재 화면에서 한 번만 영역을 골라 번역 (Ctrl+Alt+T). 우클릭: 다른 빠른 번역"><Button.ContextMenu><ContextMenu><MenuItem Header="영역 선택 번역 (Ctrl+Alt+T)" Click="QuickRegionMenuItem_Click"/><MenuItem Header="활성 창 전체 번역 (Ctrl+Alt+W)" Click="QuickWindowMenuItem_Click"/><MenuItem Header="클립보드 텍스트 번역 (Ctrl+Alt+V)" Click="QuickClipboardMenuItem_Click"/></ContextMenu></Button.ContextMenu></Button>
                <Button x:Name="StartButton" Style="{StaticResource StartNavButton}" Tag="&#xE768;" Content="시작" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Style="{StaticResource NavButton}" Tag="&#xE71A;" Content="중지" Click="StopButton_Click" IsEnabled="False"/>
                <Button x:Name="QuickOverlayEditButton" Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="오버레이" Click="ToggleOverlayEditModeButton_Click" IsEnabled="False" ToolTip="게임 위 번역 박스 위치/크기/투명도 조절"/>
                <Button x:Name="LiveWindowButton" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="번역창" Click="PreviewLiveWindowButton_Click" ToolTip="별도 실시간 번역 창 열기/다시 열기"/>
                <Button x:Name="AdvancedSettingsButton" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="설정" Click="AdvancedSettingsButton_Click" ToolTip="OCR, 번역기, API, 기록, 로그 등 고급 설정"/>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12,11">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="TARGET" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="TargetWindowText" Text="대상 창이 선택되지 않음" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="11,0,10,0" ToolTip="현재 대상 창"/><TextBlock Grid.Column="2" Text="대상 → ROI → 시작" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock x:Name="SourceLabel" Text="원문" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="SourceLanguageCombo" Height="36" SelectedValuePath="Tag" ToolTip="원문 언어. 자동 감지를 선택하면 번역기는 자동 감지하고 OCR은 옆의 다중 OCR 언어 선택을 사용합니다."><ComboBoxItem Content="자동 감지" Tag="auto"/><ComboBoxItem Content="영어" Tag="en"/><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="일본어" Tag="ja"/><ComboBoxItem Content="중국어(간체)" Tag="zh-CN"/><ComboBoxItem Content="중국어(번체)" Tag="zh-TW"/><ComboBoxItem Content="스페인어" Tag="es"/><ComboBoxItem Content="프랑스어" Tag="fr"/><ComboBoxItem Content="독일어" Tag="de"/><ComboBoxItem Content="러시아어" Tag="ru"/><ComboBoxItem Content="포르투갈어" Tag="pt"/><ComboBoxItem Content="이탈리아어" Tag="it"/><ComboBoxItem Content="베트남어" Tag="vi"/><ComboBoxItem Content="태국어" Tag="th"/><ComboBoxItem Content="인도네시아어" Tag="id"/><ComboBoxItem Content="힌디어" Tag="hi"/><ComboBoxItem Content="아랍어" Tag="ar"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="TargetLabel" Text="→ 번역" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="TargetLanguageCombo" Height="36" SelectedValuePath="Tag"><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="영어" Tag="en"/><ComboBoxItem Content="일본어" Tag="ja"/><ComboBoxItem Content="중국어(간체)" Tag="zh-CN"/><ComboBoxItem Content="중국어(번체)" Tag="zh-TW"/><ComboBoxItem Content="스페인어" Tag="es"/><ComboBoxItem Content="프랑스어" Tag="fr"/><ComboBoxItem Content="독일어" Tag="de"/><ComboBoxItem Content="러시아어" Tag="ru"/><ComboBoxItem Content="포르투갈어" Tag="pt"/><ComboBoxItem Content="이탈리아어" Tag="it"/><ComboBoxItem Content="베트남어" Tag="vi"/><ComboBoxItem Content="태국어" Tag="th"/><ComboBoxItem Content="인도네시아어" Tag="id"/><ComboBoxItem Content="힌디어" Tag="hi"/><ComboBoxItem Content="아랍어" Tag="ar"/></ComboBox></StackPanel></Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock x:Name="ModeLabel" Text="번역 방식" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="TranslationStrategyCombo" Height="36" SelectedValuePath="Tag" ToolTip="빠른 번역은 첫 번째 정상 결과만 사용합니다. 필요하면 고급 설정에서 교차검증으로 바꿀 수 있습니다."><ComboBoxItem Content="빠른 번역 · 단일 Provider" Tag="Fastest"/><ComboBoxItem Content="무료 · Web 3종 교차검증" Tag="WebOnly"/><ComboBoxItem Content="API/로컬 우선 · Web 보조검증" Tag="HybridBalanced"/><ComboBoxItem Content="API/로컬만 (안정 우선)" Tag="ApiOnly"/><ComboBoxItem Content="전체 Provider 교차검증" Tag="MaximumCrossCheck"/></ComboBox></StackPanel><Button x:Name="OcrLanguagePickerButton" Grid.Column="1" Content="OCR: 영+한" Click="OcrLanguagePickerButton_Click" Padding="10,5" Margin="10,11,0,0" VerticalAlignment="Bottom" ToolTip="OCR에서 동시에 읽을 언어를 여러 개 선택"/></Grid>
                <Border Grid.Row="4" Background="#16263D" BorderBrush="#294364" BorderThickness="1" CornerRadius="8" Padding="9,8" Margin="0,14,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="CapturePolicyStatusText" Grid.Column="0" Text="로컬 세션 · 캡처 허용" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="CaptureVisibilityCombo" Grid.Column="1" Height="32" SelectedValuePath="Tag" SelectionChanged="CaptureVisibilityCombo_SelectionChanged" ToolTip="원격 데스크톱/화면 공유에서 RoiLingo 창을 보이게 할지 선택합니다."><ComboBoxItem Content="캡처 허용" Tag="Allow"/><ComboBoxItem Content="캡처 차단" Tag="Exclude"/><ComboBoxItem Content="검정으로 표시" Tag="MonitorOnly"/></ComboBox></Grid><TextBlock Text="원격 환경에서는 캡처 허용을 권장합니다." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
        </Border>
    <Popup x:Name="AdvancedPopup" IsOpen="False" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
        <Border x:Name="AdvancedPanel" Width="1160" Height="700" Visibility="Collapsed" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="2,0,2,12"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="AdvancedTitleText" Text="고급 설정" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="OCR, Provider, API 키, 번역 기록을 한 곳에서 관리합니다." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AdvancedSaveButton" Content="저장" Click="SaveSettingsButton_Click" Padding="14,7" Background="{StaticResource AccentBrush}"/><Button x:Name="AdvancedCloseButton" Content="닫기" Click="CloseAdvancedSettingsButton_Click" Padding="14,7"/></StackPanel></DockPanel>
                <TabControl Grid.Row="1" x:Name="MainTabs">
                    <TabItem x:Name="GeneralTab" Header="설정 / ROI"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0"><GroupBox Header="OCR / 감시 설정"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Tesseract 언어팩" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="OcrLanguagesBox"/><TextBlock Grid.Row="1" Text="OCR 정확도 모드" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="OcrModeCombo" SelectedValuePath="Tag"><ComboBoxItem Content="빠름" Tag="Fast"/><ComboBoxItem Content="균형" Tag="Balanced"/><ComboBoxItem Content="정확도 우선" Tag="Accurate"/></ComboBox><TextBlock Grid.Row="2" Text="OCR 언어를 원문 언어에 맞춤" VerticalAlignment="Center"/><CheckBox Grid.Row="2" Grid.Column="1" x:Name="OcrLanguageFollowsSourceCheck" Content="원문 언어 변경 시 Tesseract 언어팩 자동 선택"/><TextBlock Grid.Row="3" Text="혼합 언어 스마트 처리" VerticalAlignment="Center"/><CheckBox Grid.Row="3" Grid.Column="1" x:Name="SmartMixedTextCheck" Content="목표 언어가 이미 섞여 있으면 그 부분은 제외하고 나머지만 번역"/><TextBlock Grid.Row="4" Text="화면 검사 간격(ms)" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="PollIntervalBox"/><TextBlock Grid.Row="5" Text="변화 감도 (0.01~0.20)" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="ChangeThresholdBox"/><TextBlock Grid.Row="6" Text="창 캡처 방식" VerticalAlignment="Center"/><ComboBox Grid.Row="6" Grid.Column="1" x:Name="CaptureModeCombo" SelectedValuePath="Tag"><ComboBoxItem Content="자동 (전면 게임=화면 / 비활성=백그라운드)" Tag="Auto"/><ComboBoxItem Content="백그라운드 우선" Tag="BackgroundFirst"/><ComboBoxItem Content="백그라운드만" Tag="BackgroundOnly"/></ComboBox><TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="자동은 전면 GPU 게임에서는 화면 캡처를 우선하고, 가려진 창에서는 백그라운드 캡처를 시도합니다." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="4,8,4,0"/></Grid></GroupBox><GroupBox Header="자동 기록 / 표시"><StackPanel Margin="10"><CheckBox x:Name="AutoSaveHistoryCheck" Content="OCR / 번역 결과 자동 저장" IsChecked="True"/><CheckBox x:Name="LiveWindowEnabledCheck" Content="시작할 때 별도 실시간 번역 창 자동 열기"/><WrapPanel Margin="0,7,0,0"><Button Content="실시간 번역 창 열기/다시 열기" Click="PreviewLiveWindowButton_Click"/><Button x:Name="OverlayEditModeButton" Content="게임 오버레이 직접 편집" Click="ToggleOverlayEditModeButton_Click"/><Button Content="게임 오버레이 세부 설정" Click="OpenOverlaySettingsButton_Click"/></WrapPanel></StackPanel></GroupBox></StackPanel>
                        <GroupBox Grid.Column="1" Header="ROI 목록"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="선택 ROI 삭제" Click="DeleteRoiButton_Click" HorizontalAlignment="Right" Margin="2,8,2,0"/><DataGrid x:Name="RoiGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="오버레이" Binding="{Binding ShowOverlay}" Width="80"/><DataGridCheckBoxColumn Header="이벤트" Binding="{Binding EventMode}" Width="70"/></DataGrid.Columns></DataGrid></DockPanel></GroupBox>
                    </Grid></TabItem>
                    <TabItem x:Name="WebTab" Header="번역 웹 / 교차 검증"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,0,9"><WrapPanel><CheckBox x:Name="PapagoWebEnabled" Content="Papago"/><CheckBox x:Name="GoogleWebEnabled" Content="Google"/><CheckBox x:Name="DeepLWebEnabled" Content="DeepL"/><CheckBox x:Name="ClipboardFallbackCheck" Content="복사 버튼/클립보드 폴백" Margin="15,6,5,6"/><TextBlock Text="웹 타임아웃(ms)" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBox x:Name="WebTimeoutBox" Width="72"/><Button Content="번역 캐시 비우기" Click="ClearTranslationCacheButton_Click"/><Button Content="번역 결과 읽기 테스트" Click="TestWebTranslatorsButton_Click"/><Button Content="번역 사이트 초기화/새로고침" Click="InitializeWebTranslatorsButton_Click"/></WrapPanel></Border><TabControl Grid.Row="1" x:Name="TranslatorSiteTabs"><TabItem Header="Papago"><Grid><wv2:WebView2 x:Name="PapagoWebView"/></Grid></TabItem><TabItem Header="Google 번역"><Grid><wv2:WebView2 x:Name="GoogleWebView"/></Grid></TabItem><TabItem Header="DeepL"><Grid><wv2:WebView2 x:Name="DeepLWebView"/></Grid></TabItem></TabControl></Grid></TabItem>
                    <TabItem x:Name="ApiTab" Header="번역 API / 로컬"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><GroupBox Header="번역 실행 전략"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="300"/><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="전략" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="기본 창의 방식을 사용합니다." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="최종 결과 우선" VerticalAlignment="Center"/><ComboBox Grid.Column="3" x:Name="PreferredProviderCombo"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Papago API"/><ComboBoxItem Content="Google API"/><ComboBoxItem Content="DeepL API"/><ComboBoxItem Content="LibreTranslate"/><ComboBoxItem Content="Papago Web"/><ComboBoxItem Content="Google Web"/><ComboBoxItem Content="DeepL Web"/></ComboBox><TextBlock Grid.Column="4" Text="API 타임아웃(ms)" VerticalAlignment="Center"/><TextBox Grid.Column="5" x:Name="ApiTimeoutBox"/></Grid></GroupBox><GroupBox Header="Papago Text Translation API"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><CheckBox Grid.Column="0" x:Name="PapagoApiEnabled" Content="사용"/><StackPanel Grid.Column="1"><TextBlock Text="Client ID"/><PasswordBox x:Name="PapagoClientIdBox"/></StackPanel><TextBlock Grid.Column="2" Text="Client Secret" VerticalAlignment="Center"/><PasswordBox Grid.Column="3" x:Name="PapagoClientSecretBox"/><TextBlock Grid.Column="4" Text="일 요청 한도" VerticalAlignment="Center"/><TextBox Grid.Column="5" x:Name="PapagoDailyLimitBox"/><TextBlock Grid.Column="6"