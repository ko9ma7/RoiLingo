<Window x:Class="RobloxLiveTranslator.Quick.QuickResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoiLingo - 빠른 번역" Width="560" Height="300" MinWidth="360" MinHeight="190"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="복사" Click="CopyButton_Click" Padding="10,4" Margin="2"/>
                <Button Content="닫기" Click="CloseButton_Click" Padding="10,4" Margin="2"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="원문" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox x:Name="SourceBox" Grid.Row="0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="1" Padding="7" MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
            <TextBox x:Name="TranslationBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="1" Padding="8" FontSize="20" FontWeight="SemiBold" VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <TextBlock x:Name="MetaText" Grid.Row="3" Foreground="#666" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
