<Window x:Class="RobloxLiveTranslator.RoiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#18000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid>
        <Canvas x:Name="RoiCanvas"/>
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8" Padding="12,7"
                Background="#DD111111" CornerRadius="8" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="14"
                       Text="드래그: ROI 추가   |   우클릭: 마지막 ROI 삭제   |   Enter: 저장   |   Esc: 취소"/>
        </Border>
    </Grid>
</Window>
