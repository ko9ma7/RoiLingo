<Window x:Class="RobloxLiveTranslator.Overlay.OverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoiLingo - 게임 오버레이 설정"
        Width="560" Height="650" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="게임 위 반투명 번역 오버레이" FontWeight="Bold" FontSize="15"/>
                <TextBlock Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"
                           Text="ROI별 위치, 실제 가로/세로 크기, 유지 시간, 투명도와 글자 크기를 조절합니다. 너비/높이 0은 내용에 맞춘 자동 크기입니다."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="82"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="대상 ROI" VerticalAlignment="Center" Margin="0,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RoiCombo"
                          DisplayMemberPath="Name" SelectionChanged="RoiCombo_SelectionChanged" Margin="0,4"/>

                <TextBlock Grid.Row="1" Text="가로 위치 보정" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="OffsetXSlider" Minimum="-1000" Maximum="1000"
                        TickFrequency="10" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="OffsetXText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Text="세로 위치 보정" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="2" Grid.Column="1" x:Name="OffsetYSlider" Minimum="-800" Maximum="800"
                        TickFrequency="10" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OffsetYText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="3" Text="오버레이 너비 (px)" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="3" Grid.Column="1" x:Name="WidthSlider" Minimum="0" Maximum="1600"
                        TickFrequency="20" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="WidthText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="4" Text="오버레이 높이 (px)" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="4" Grid.Column="1" x:Name="HeightSlider" Minimum="0" Maximum="900"
                        TickFrequency="10" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="HeightText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="5" Text="번역 표시 유지 시간" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="5" Grid.Column="1" x:Name="HoldSecondsSlider" Minimum="0" Maximum="120"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="HoldSecondsText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="6" Text="배경 불투명도" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="6" Grid.Column="1" x:Name="OpacitySlider" Minimum="0.1" Maximum="1"
                        TickFrequency="0.05" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="6" Grid.Column="2" x:Name="OpacityText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="7" Text="번역 글자 크기" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="7" Grid.Column="1" x:Name="FontSizeSlider" Minimum="10" Maximum="42"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="7" Grid.Column="2" x:Name="FontSizeText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="8" Text="표시 내용" VerticalAlignment="Top" Margin="0,10,8,10"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8">
                    <CheckBox x:Name="ShowSourceCheck" Content="OCR 원문 같이 표시" Click="CheckBox_Click"/>
                    <CheckBox x:Name="ShowMetaCheck" Content="Provider / OCR 정확도 / 교차 일치도 표시" Margin="0,6,0,0" Click="CheckBox_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="9" Grid.ColumnSpan="3" Margin="0,14,0,4" Foreground="#666" TextWrapping="Wrap"
                           Text="유지 시간 0초는 다음 번역이 나올 때까지 계속 표시합니다. 순간적으로 사라지는 게임 공지도 OCR 스냅샷으로 번역을 끝까지 처리하고 기록에 남깁니다."/>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="선택 ROI 기본값" Click="ResetButton_Click" Padding="12,6" DockPanel.Dock="Left"/>
            <Button Content="닫기" Click="CloseButton_Click" Padding="18,6" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
