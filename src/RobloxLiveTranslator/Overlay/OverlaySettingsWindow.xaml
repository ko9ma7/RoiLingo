<Window x:Class="RobloxLiveTranslator.Overlay.OverlaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoiLingo - 게임 오버레이 설정"
        Width="520" Height="560" MinWidth="470" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F4F4" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="게임 위 반투명 번역 오버레이" FontWeight="Bold" FontSize="15"/>
                <TextBlock Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"
                           Text="ROI별로 위치 보정, 너비, 투명도, 글자 크기, 표시 내용을 조절합니다. 감시 중에도 즉시 반영됩니다."/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="대상 ROI" VerticalAlignment="Center" Margin="0,6"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RoiCombo"
                          DisplayMemberPath="Name" SelectionChanged="RoiCombo_SelectionChanged" Margin="0,4"/>

                <TextBlock Grid.Row="1" Text="가로 위치 보정" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="OffsetXSlider" Minimum="-1000" Maximum="1000"
                        TickFrequency="10" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="OffsetXText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Text="세로 위치 보정" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="2" Grid.Column="1" x:Name="OffsetYSlider" Minimum="-800" Maximum="800"
                        TickFrequency="10" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OffsetYText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="3" Text="오버레이 너비" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="3" Grid.Column="1" x:Name="WidthScaleSlider" Minimum="0.45" Maximum="3"
                        TickFrequency="0.05" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="WidthScaleText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="4" Text="배경 불투명도" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="4" Grid.Column="1" x:Name="OpacitySlider" Minimum="0.1" Maximum="1"
                        TickFrequency="0.05" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="OpacityText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="5" Text="번역 글자 크기" VerticalAlignment="Center" Margin="0,10,8,10"/>
                <Slider Grid.Row="5" Grid.Column="1" x:Name="FontSizeSlider" Minimum="10" Maximum="42"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged" Margin="0,8"/>
                <TextBlock Grid.Row="5" Grid.Column="2" x:Name="FontSizeText" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="6" Text="표시 내용" VerticalAlignment="Top" Margin="0,10,8,10"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8">
                    <CheckBox x:Name="ShowSourceCheck" Content="OCR 원문 같이 표시" Click="CheckBox_Click"/>
                    <CheckBox x:Name="ShowMetaCheck" Content="Provider / OCR 정확도 / 교차 일치도 표시" Margin="0,6,0,0" Click="CheckBox_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Margin="0,14,0,4" Foreground="#666" TextWrapping="Wrap"
                           Text="위치 보정 0/0은 기존처럼 ROI 아래(공간이 없으면 위)에 자동 배치됩니다. 값은 각 ROI별로 자동 저장됩니다."/>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="선택 ROI 기본값" Click="ResetButton_Click" Padding="12,6" DockPanel.Dock="Left"/>
            <Button Content="닫기" Click="CloseButton_Click" Padding="18,6" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
