<Window x:Class="RobloxLiveTranslator.Overlay.LiveTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoiLingo - 실시간 번역 창"
        Width="560" Height="360" MinWidth="360" MinHeight="220"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
        Topmost="True" Background="#151515" Foreground="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#222" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <CheckBox x:Name="TopmostCheck" Content="항상 위" IsChecked="True" Margin="0,0,12,0"
                              VerticalAlignment="Center" Click="TopmostCheck_Click"/>
                    <CheckBox x:Name="ShowSourceCheck" Content="원문 표시" IsChecked="True" Margin="0,0,12,0"
                              VerticalAlignment="Center" Click="ShowSourceCheck_Click"/>
                    <TextBlock Text="글자 크기" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="FontSizeSlider" Width="120" Minimum="12" Maximum="32" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="FontSizeSlider_ValueChanged"/>
                </StackPanel>
                <Button Content="목록 지우기" DockPanel.Dock="Right" Padding="10,4" Click="ClearButton_Click"/>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="1" x:Name="TranslationList" Background="#101010" BorderBrush="#333"
                 BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1C1C1C" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="9,8">
                        <StackPanel>
                            <TextBlock Foreground="#9E9E9E" FontSize="11">
                                <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding RoiName}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding Provider}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SourceText}" Foreground="#BDBDBD" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding SourceVisibility}"/>
                            <TextBlock Text="{Binding TargetText}" Foreground="White" FontWeight="SemiBold"
                                       FontSize="{Binding TargetFontSize}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
